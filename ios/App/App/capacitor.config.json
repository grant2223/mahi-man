{
	"appId": "com.moremahi.app",
	"appName": "More Mahi",
	"webDir": "dist",
	"backgroundColor": "#0B6B4F",
	"ios": {
		"contentInset": "never",
		"limitsNavigationsToAppBoundDomains": false
	},
	"plugins": {
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"KeyboardPlugin",
		"PushNotificationsPlugin"
	]
}
