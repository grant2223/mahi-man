{
	"appId": "com.mahiman.app",
	"appName": "Mahi Man",
	"webDir": "dist",
	"backgroundColor": "#0B6B4F",
	"ios": {
		"contentInset": "never",
		"limitsNavigationsToAppBoundDomains": false
	},
	"android": {
		"useLegacyBridge": true
	},
	"plugins": {
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"SignInWithApple",
		"BackgroundGeolocation",
		"AppPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"SharePlugin"
	]
}
